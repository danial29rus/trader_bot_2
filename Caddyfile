{
	# Certificates come from Let's Encrypt; the short-lived profile also covers bare IP addresses.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	# Safari often omits SNI when the URL is a bare IP address. Serve the IP
	# certificate that belongs to this deployment instead of failing TLS.
	default_sni {$PUBLIC_HOST}
}

{$PUBLIC_HOST} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	# Public legal pages; no forms, analytics or cookies are served here.
	handle /docs/* {
		reverse_proxy admin-api:8000
	}

	reverse_proxy admin-web:80
}
